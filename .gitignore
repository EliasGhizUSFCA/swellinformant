# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
*.tsbuildinfo
next-env.d.ts

# Environment & secrets (the two examples hold placeholders only)
.env
.env.*
!.env.example
!.env.vercel.example
# Database dumps hold accounts and password hashes (scripts/backup-db.sh writes ./backups/)
/backups/
*.dump

# Vercel CLI: `vercel link`, `vercel pull` and `vercel build` write .vercel/ at the root
# (project id, pulled env files with secrets, build output); `vercel dev` also writes
# backend/.vercel/python
.vercel/
# The api service's build command copies the repository's data/ into backend/data (the
# function bundle's copy); git keeps only data/ (app/core/data_files.py)
/backend/data/

# OS / editors
.DS_Store
.idea/
.vscode/
*.swp

# Local data
/tmp/
*.log
# alternate Next.js build dirs (NEXT_DIST_DIR), e.g. .next-e2e/
.next-*/
# written by `next dev` 16.x for coding agents (agentRules: false in next.config.ts)
frontend/AGENTS.md

# Redis local dumps
dump.rdb

# celery beat local state
celerybeat-schedule*

# Agent worktrees created by Claude Code workflows
.claude/worktrees/
