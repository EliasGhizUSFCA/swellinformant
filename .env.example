# Swell Travel Agent — configuration template.
#
# Copy to `.env` (repository root). Every value below has a working default for demo mode, so
# `docker compose up --build` runs without editing anything. Never commit a real `.env`.
# Do not put real credentials in this file.
#
# The backend reads `.env` (or `../.env` when started from backend/). docker compose also reads
# it for variable substitution. Inside compose, DATABASE_URL / REDIS_URL / CELERY_* are set to
# the compose services automatically, so those entries only matter for running outside Docker.

# ----------------------------------------------------------------------------- general
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# public URL of the web app (used in email links)
APP_BASE_URL=http://localhost:3000
# public URL of the API (Twilio webhook signature check)
API_BASE_URL=http://localhost:8000
# Required in production: a long random value, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
SECRET_KEY=dev-insecure-secret-change-me
# Exposes /api/dev/* (simulate a swell, run the pipeline, read the outbox). Never in production.
ENABLE_DEV_ENDPOINTS=false

# ----------------------------------------------------------------------------- infrastructure
DATABASE_URL=postgresql+psycopg://swell:swell@localhost:5432/swell
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# true = run jobs in-process (tests / single-process dev)
CELERY_TASK_ALWAYS_EAGER=false
# queue one full pipeline run when celery beat starts
BEAT_RUN_ON_START=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Used by docker compose for the postgres container and host port mappings
POSTGRES_USER=swell
POSTGRES_PASSWORD=swell
POSTGRES_DB=swell
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
API_WORKERS=2
WORKER_CONCURRENCY=2

# ----------------------------------------------------------------------------- HTTP & security
# comma separated; the web app proxies /api so CORS is rarely needed
CORS_ORIGINS=http://localhost:3000
SESSION_TTL_DAYS=14
# must be true in production (HTTPS)
COOKIE_SECURE=false
COOKIE_DOMAIN=
RATE_LIMIT_ENABLED=true
LOGIN_MAX_FAILURES=8
LOGIN_LOCKOUT_MINUTES=15
EMAIL_VERIFICATION_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=60
# reverse proxies in front of the API (for client IPs)
TRUSTED_PROXY_COUNT=1

# ----------------------------------------------------------------------------- forecasts
# Comma separated, first = primary: demo | open_meteo | windy  ("demo" cannot be mixed with live ones)
FORECAST_PROVIDERS=demo
# 3–16
FORECAST_DAYS=16
FORECAST_REFRESH_MINUTES=180
FORECAST_STALE_HOURS=18
# spots per Open-Meteo request
FORECAST_BATCH_SIZE=10
FORECAST_HTTP_TIMEOUT_SECONDS=30
FORECAST_DAILY_REQUEST_QUOTA=5000
# Open-Meteo works without a key for non-commercial use; a key selects the commercial endpoint.
OPEN_METEO_API_KEY=
# NOAA GFS-Wave 0.25°
OPEN_METEO_WAVE_MODEL=ncep_gfswave025
# NOAA GFS
OPEN_METEO_ATMOS_MODEL=gfs_seamless
# Windy Point Forecast API (licensed): https://api.windy.com/point-forecast
WINDY_API_KEY=
# demo provider generates its own random swells
DEMO_NATURAL_SWELLS=true

# ----------------------------------------------------------------------------- swell detection
DETECTION_LEAD_MIN_DAYS=5
DETECTION_LEAD_MAX_DAYS=10
SWELL_EVENT_MIN_SCORE=40
SWELL_EVENT_MIN_HOURS=3
SWELL_EVENT_BREAK_DAYLIGHT_HOURS=9

# ----------------------------------------------------------------------------- flights
# demo | duffel | amadeus
FLIGHT_PROVIDER=demo
# https://duffel.com — "duffel_test_..." for the sandbox
DUFFEL_ACCESS_TOKEN=
DUFFEL_BASE_URL=https://api.duffel.com
# Amadeus Enterprise (Self-Service portal is closed to new users)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://api.amadeus.com
FLIGHT_HTTP_TIMEOUT_SECONDS=45
FLIGHT_CACHE_TTL_HOURS=6
# provider searches per day, all users
FLIGHT_DAILY_QUOTA=300
FLIGHT_MAX_QUERIES_PER_MATCH=3
FLIGHT_REFRESH_HOURS=12
FLIGHT_OFFER_MAX_AGE_HOURS=24
FLIGHT_MAX_OFFERS_PER_SEARCH=50
# Optional currency conversion for budgets, units per 1 USD, e.g. {"EUR":0.92,"GBP":0.79}.
# Without it, offers in a currency other than the search budget's are not compared to the budget.
FX_RATES_USD_JSON=

# ----------------------------------------------------------------------------- notifications
# console | smtp | resend | sendgrid
EMAIL_PROVIDER=console
EMAIL_FROM=Swell Travel Agent <alerts@localhost>
RESEND_API_KEY=
SENDGRID_API_KEY=
# default localhost; inside compose: the optional mailpit service
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
# console | twilio | disabled
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_SENDING_TIMEOUT_MINUTES=10
ALERT_PRICE_DROP_PCT=10
ALERT_PRICE_DROP_MIN_AMOUNT=50
ALERT_SCORE_IMPROVEMENT=10
MAX_ALERTS_PER_USER_PER_DAY=10
# console providers write messages here
OUTBOX_DIR=/tmp/swell-outbox

# ----------------------------------------------------------------------------- ranking & retention
# Optional JSON overriding opportunity ranking weights per priority (see docs/MATCHING_AND_FLIGHTS.md)
RANKING_WEIGHTS_JSON=
RETENTION_FORECAST_DAYS=10
RETENTION_FLIGHT_DAYS=30
RETENTION_JOB_LOG_DAYS=30
RETENTION_NOTIFICATION_DAYS=365

# ----------------------------------------------------------------------------- frontend
# Read by the Next.js server at build time (export them, or put them in frontend/.env.local
# for `npm run dev`). BACKEND_URL is where /api/* is proxied; compose sets it to the backend service.
BACKEND_URL=http://localhost:8000
# default: CARTO Voyager raster tiles (OpenStreetMap data)
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
# CSP img-src hosts for custom tiles, space separated
MAP_TILE_HOSTS=
