# Swell Travel Agent — configuration template.
#
# Copy to `.env` (repository root). Every value below has a working default for demo mode, so
# `docker compose up --build` runs without editing anything. Never commit a real `.env`.
# Do not put real credentials in this file.
#
# The backend reads `.env` (or `../.env` when started from backend/). docker compose also reads
# it for variable substitution. Inside compose, DATABASE_URL / REDIS_URL / CELERY_* are set to
# the compose services automatically, so those entries only matter for running outside Docker.

# ----------------------------------------------------------------------------- general
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# Public URL of the web app, used in every email link. Empty = http://localhost:3000, or in
# Docker http://localhost:${FRONTEND_PORT}. Set it explicitly when deployed behind a domain.
APP_BASE_URL=
# Public URL of the API (unsubscribe header, provider webhooks). Empty = localhost:8000 /
# http://localhost:${BACKEND_PORT} in Docker.
API_BASE_URL=
# Required in production: a long random value, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
SECRET_KEY=dev-insecure-secret-change-me
# Exposes /api/dev/* (simulate a swell, run the pipeline, read the outbox). Never in production.
ENABLE_DEV_ENDPOINTS=false

# ----------------------------------------------------------------------------- infrastructure
# postgres:// and postgresql:// URLs (as Neon hands them out) are rewritten to
# postgresql+psycopg://, keeping the query string (sslmode, channel_binding).
DATABASE_URL=postgresql+psycopg://swell:swell@localhost:5432/swell
# Direct (not pooled) connection to the same database, used by migrations and, with
# DB_USE_UNPOOLED=true, by the whole process (the sync daemon image sets that). Vercel's Neon
# integration sets it (POSTGRES_URL_NON_POOLING is read too). Empty = DATABASE_URL.
DATABASE_URL_UNPOOLED=
DB_USE_UNPOOLED=false
# Connections older than this many seconds are replaced (hosted profile: 240)
DB_POOL_RECYCLE_SECONDS=1800
# false = never prepare statements (needed behind a PgBouncer in transaction mode, e.g. Neon's
# pooled URL; hosted profile: false)
DB_PREPARED_STATEMENTS=true
# KV_URL (set by Vercel's Upstash integration) is read when REDIS_URL is empty
REDIS_URL=redis://localhost:6379/0
# Redis connect and socket timeouts in seconds (hosted profile: 1.5 and 2)
REDIS_CONNECT_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=5
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# true = run jobs in-process (tests / single-process dev)
CELERY_TASK_ALWAYS_EAGER=false
# queue one full pipeline run when celery beat starts
BEAT_RUN_ON_START=true
# hosted profile: 2 and 3
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Used by docker compose for the postgres container and host port mappings
POSTGRES_USER=swell
POSTGRES_PASSWORD=swell
POSTGRES_DB=swell
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
API_WORKERS=2
WORKER_CONCURRENCY=2
# queues the Celery worker consumes (downloads go to "bulk")
WORKER_QUEUES=celery,bulk
# Redis memory cap (the broker never evicts; the data-health check warns before it is reached)
REDIS_MAXMEMORY=256mb

# ----------------------------------------------------------------------------- HTTP & security
# Comma separated; the web app proxies /api so CORS is rarely needed. Empty = the app URL.
CORS_ORIGINS=
SESSION_TTL_DAYS=14
# must be true in production (HTTPS)
COOKIE_SECURE=false
COOKIE_DOMAIN=
RATE_LIMIT_ENABLED=true
LOGIN_MAX_FAILURES=8
LOGIN_LOCKOUT_MINUTES=15
EMAIL_VERIFICATION_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=60
# reverse proxies in front of the API (for client IPs)
TRUSTED_PROXY_COUNT=1
# Header that carries the client IP, set by the platform and not by clients (hosted profile:
# x-vercel-forwarded-for). Empty = X-Forwarded-For with TRUSTED_PROXY_COUNT.
CLIENT_IP_HEADER=

# ----------------------------------------------------------------------------- runner & sync
# Who runs background jobs: celery (worker + beat, this docker compose stack) or daemon (one
# `python -m app.cli sync daemon` process, e.g. a Vercel Daemon; hosted profile).
JOB_RUNNER=celery
# Bearer token of the daily watchdog GET /api/internal/cron/daily (at least 16 characters;
# `python -c "import secrets;print(secrets.token_urlsafe(48))"`). Empty = the route answers 404.
CRON_SECRET=
# `python -m app.cli migrate --on-build`: off | production (only when VERCEL_ENV=production;
# hosted profile) | all (also preview builds)
MIGRATE_ON_BUILD=off
# true once the site is used commercially (paywall, ads). The free Open-Meteo API is
# non-commercial, so open_meteo / open_meteo_ecmwf then need OPEN_METEO_API_KEY.
COMMERCIAL_USE=false
# Minutes between model-run checks (provider metadata only, no database access)
SYNC_CHECK_MINUTES=10
# A new GFS spot run and the map layers of the same cycle wait for each other this long
SYNC_COALESCE_MINUTES=90
# The sync lease (one sync at a time), renewed at every stage
SYNC_LEASE_MINUTES=45
# Failed attempts per model run, and minutes between them, before waiting for the next run
SYNC_MAX_ATTEMPTS=6
SYNC_RETRY_MINUTES=15
# Components whose new model run starts a sync: subset of spots,map,ensemble
SYNC_TRIGGER_SOURCES=spots,map
# Prune superseded predictions and map fields after every sync (free-database profile: true)
SYNC_PRUNE_EACH_PASS=false
# The map serves the run of the newest published sync
SYNC_PUBLISH_GATE=true
# Seconds between the daemon's checks for "match my search" / "refresh flights" requests
SYNC_DAEMON_POLL_SECONDS=60
# The daemon migrates, seeds and loads the tide catalog at start (idempotent)
SYNC_DAEMON_INIT_DB=true
# Monthly CPU budget of the sync runner in hours; health warns near it (hosted profile: 10,
# Vercel Hobby's daemon quota). Empty = no budget.
SYNC_CPU_BUDGET_HOURS=
# Periodic jobs run at most once per this many minutes (0 = as scheduled; hosted profile: 60,
# so a scale-to-zero database is woken at most hourly between syncs)
JOB_INTERVAL_FLOOR_MINUTES=0

# ----------------------------------------------------------------------------- forecasts
# Comma separated, first = primary: demo | noaa_gfs | ecmwf_ifs | open_meteo (Open-Meteo, GFS
# family) | open_meteo_ecmwf (Open-Meteo, ECMWF family) | windy (refused unless
# WINDY_TERMS_ACKNOWLEDGED=true). "demo" cannot be mixed with live ones. Recommended live setup:
# open_meteo,open_meteo_ecmwf (API-first: two independent model families, blended; small point
# requests, no key for non-commercial use, see docs/API_SETUP_REQUIRED.md). Key-free fallbacks
# that read NOAA / ECMWF open data directly (GRIB by byte range, larger downloads):
# noaa_gfs,ecmwf_ifs.
FORECAST_PROVIDERS=demo
# 3–16
FORECAST_DAYS=16
FORECAST_REFRESH_MINUTES=180
FORECAST_STALE_HOURS=18
# spots per Open-Meteo request (1-50; 50 = all seeded spots in one request per model)
FORECAST_BATCH_SIZE=50
FORECAST_HTTP_TIMEOUT_SECONDS=30
FORECAST_DAILY_REQUEST_QUOTA=5000
# Open-Meteo works without a key for non-commercial use; a key selects the commercial endpoint.
OPEN_METEO_API_KEY=
# Open-Meteo GFS family ("open_meteo"): wave models in routing order (ncep_gfswave016 only
# covers about 52.5N..15S; ncep_gfswave025 is global) and the atmosphere model (gfs_seamless,
# HRRR + GFS, is also accepted).
OPEN_METEO_GFS_WAVE_MODELS=ncep_gfswave016,ncep_gfswave025
OPEN_METEO_GFS_ATMOS_MODEL=gfs_global
# Open-Meteo ECMWF family ("open_meteo_ecmwf")
OPEN_METEO_ECMWF_WAVE_MODEL=ecmwf_wam025
OPEN_METEO_ECMWF_ATMOS_MODEL=ecmwf_ifs025
# Deprecated, single-model aliases: when set they override the two GFS-family settings above.
# OPEN_METEO_WAVE_MODEL=ncep_gfswave025
# OPEN_METEO_ATMOS_MODEL=gfs_seamless
# sea | nearest | land: which grid cell Open-Meteo samples for a spot
OPEN_METEO_CELL_SELECTION=sea
# use a new model run only this many minutes after Open-Meteo reports it available
OPEN_METEO_AVAILABILITY_WAIT_MINUTES=10
# keep only the models' native output steps (no interpolated hours)
OPEN_METEO_NATIVE_STEPS_ONLY=true
# weighted-call budgets (Open-Meteo free tier)
OPEN_METEO_CALLS_PER_MINUTE=600
OPEN_METEO_CALLS_PER_HOUR=5000
OPEN_METEO_CALLS_PER_DAY=10000
OPEN_METEO_CALLS_PER_MONTH=300000
# Response cache for API providers in Redis: bodies over MAX_BYTES are not cached (hosted
# profile: false, Upstash Free stores 250 MB)
PROVIDER_RESPONSE_CACHE_ENABLED=true
PROVIDER_RESPONSE_CACHE_MAX_BYTES=2000000
PROVIDER_RESPONSE_CACHE_MAX_KEYS=200
# Windy Point Forecast API (licensed): https://api.windy.com/point-forecast
WINDY_API_KEY=
# Windy's terms forbid storing its data and derived databases. "windy" in FORECAST_PROVIDERS is
# refused unless this is true (set it only with a licence that allows this use).
WINDY_TERMS_ACKNOWLEDGED=false
# demo provider generates its own random swells
DEMO_NATURAL_SWELLS=true

# ----------------------------------------------------------------------------- forecast engine
# Blend independent model families (needs two of them in FORECAST_PROVIDERS).
FORECAST_BLEND_ENABLED=true
# NOAA open data (GRIB2 by byte range). ~24 MB per step for 50 spots; ~2 GB per 10-day run.
NOAA_GFS_BASE_URL=https://noaa-gfs-bdp-pds.s3.amazonaws.com
NOAA_STEP_HOURS=3
NOAA_MAX_LEAD_HOURS=240
NOAA_AVAILABILITY_LAG_HOURS=5
# GEFS-Wave ensemble mean/spread for the uncertainty ranges (GEFS_STAT_FIELDS only:
# 69.4 MB per run, measured 2026-10-16; about 200 MB before that trimming). Hosted profile:
# false, to protect the daemon's CPU quota; true turns it on.
GEFS_ENABLED=false
NOAA_GEFS_BASE_URL=https://noaa-gefs-pds.s3.amazonaws.com
# GEFS-Wave records read per step, and the cycles read (UTC)
GEFS_STAT_FIELDS=HTSGW,PERPW
GEFS_CYCLES=00,06,12,18
# ECMWF open data (CC BY 4.0; attribution is shown automatically)
ECMWF_BASE_URL=https://ecmwf-forecasts.s3.eu-central-1.amazonaws.com
ECMWF_MAX_LEAD_HOURS=240
# ECMWF wave parameters read (GRIB short names)
ECMWF_WAVE_PARAMS=swh,mwd,pp1d,mwp
GRIB_DOWNLOAD_WORKERS=6
GRIB_MAX_CELL_DISTANCE_KM=60
# Map ocean layers. Empty = automatic (see docs/map-layers.md), true = always, false = off.
MAP_FIELDS_ENABLED=
# GFS atmosphere grid for the map's wind and pressure (0p25 | 0p50 | 1p00) and its file layout
MAP_FIELD_ATMOS_GRID=0p50
MAP_FIELD_ATMOS_PATH_TEMPLATE=gfs.{ymd}/{hh}/atmos/gfs.t{hh}z.pgrb2.{grid}.f{fhour:03d}
# map hours per cycle ("start-end:step" in forecast hours) and the GFS cycles read (UTC)
MAP_FIELD_STEPS=0-120:3,120-240:6
MAP_FIELD_CYCLES=00,12
# on | off: primary swell, secondary swell and wind-sea layers (about 5 MB more per map hour)
MAP_FIELD_PARTITIONS=on
# a map-field run stops before downloading more than this (bytes)
MAP_FIELD_MAX_BYTES_PER_RUN=600000000
# the map's ocean layers are flagged stale once their model cycle is older than this (hours;
# with cycles 00,12 a cycle is normally 17-20 h old when the next one replaces it)
MAP_FIELD_STALE_AFTER_HOURS=21
# Deprecated, no longer read (MAP_FIELD_STEPS decides the map hours):
# MAP_FIELD_STEP_HOURS=3

# ----------------------------------------------------------------------------- scoring
# off | scored: wind gusts are shown, and scored only where the source's gust definition is known
WIND_GUST_SCORING=off

# ----------------------------------------------------------------------------- verification & ML
# Buoy observations (AODN, Met Office, NDBC), forecast archiving at buoys and metrics.
OBSERVATIONS_ENABLED=false
OBSERVATION_PROVIDERS=aodn,metoffice,ndbc
# read NDBC's 5-day files when the look-back window fits in them
NDBC_USE_5DAY=true
# quality-controlled buoy observations are kept this many days
OBSERVATION_RETENTION_DAYS=3650
VERIFICATION_ENABLED=false
# Apply an ML correction only if one passed the deployment criteria and is active.
ML_CORRECTIONS_ENABLED=true
ML_ARTIFACT_DIR=/tmp/swell-ml
# Archived predictions (what was forecast at each lead) are kept this long (free-database
# profile: 7).
RETENTION_ARCHIVE_DAYS=730
# archive a short digest of the confidence inputs instead of the full inputs
ARCHIVE_CONFIDENCE_DIGEST=true
# daily cleanup deletes the predictions of superseded runs no spot is served from (derived
# data: the forecasts are kept and the predictions can be recomputed)
PRUNE_SUPERSEDED_MEMBER_PREDICTIONS=true

# ----------------------------------------------------------------------------- tides
# Comma separated, first = preferred: noaa_coops (NOAA CO-OPS predictions, US stations) |
# harmonic_model (committed harmonic constants, evaluated locally). Empty = no tides (the daily
# tides.acquire job is then not scheduled).
TIDE_PROVIDERS=noaa_coops,harmonic_model
NOAA_COOPS_BASE_URL=https://api.tidesandcurrents.noaa.gov
# the "application" name sent to CO-OPS; empty = the app name
NOAA_COOPS_APPLICATION=
# eot20 | fes2022: the harmonic constants used by harmonic_model, and their file
TIDE_MODEL=eot20
TIDE_CONSTANTS_PATH=data/tides/constants_eot20.json
TIDE_HORIZON_DAYS=16
# past tide predictions kept (days)
TIDE_RETENTION_PAST_DAYS=2

# ----------------------------------------------------------------------------- swell detection
DETECTION_LEAD_MIN_DAYS=5
DETECTION_LEAD_MAX_DAYS=10
SWELL_EVENT_MIN_SCORE=40
SWELL_EVENT_MIN_HOURS=3
SWELL_EVENT_BREAK_DAYLIGHT_HOURS=9

# ----------------------------------------------------------------------------- flights
# demo | duffel | amadeus
FLIGHT_PROVIDER=demo
# https://duffel.com — "duffel_test_..." for the sandbox
DUFFEL_ACCESS_TOKEN=
DUFFEL_BASE_URL=https://api.duffel.com
# Amadeus Enterprise (Self-Service portal is closed to new users)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://api.amadeus.com
FLIGHT_HTTP_TIMEOUT_SECONDS=45
FLIGHT_CACHE_TTL_HOURS=6
# provider searches per day, all users
FLIGHT_DAILY_QUOTA=300
FLIGHT_MAX_QUERIES_PER_MATCH=3
FLIGHT_REFRESH_HOURS=12
FLIGHT_OFFER_MAX_AGE_HOURS=24
FLIGHT_MAX_OFFERS_PER_SEARCH=50
# Optional currency conversion for budgets: USD per 1 unit of the currency,
# e.g. {"EUR":1.08,"GBP":1.27} (1,000 EUR = 1,080 USD).
# Without it, offers in a currency other than the search budget's are not compared to the budget.
FX_RATES_USD_JSON=

# ----------------------------------------------------------------------------- notifications
# Where email goes:
#   mailpit  - development inbox: every email is captured at DEV_INBOX_URL (Docker default)
#   console  - development file: OUTBOX_DIR/outbox.jsonl (default outside Docker)
#   smtp | resend | sendgrid - real delivery (needs a verified sending domain, see README)
# Leave empty for the default. Capture providers are refused when APP_ENV=production.
EMAIL_PROVIDER=
# Sender. For real delivery this must be an address on a domain verified with your provider.
EMAIL_FROM=Swell Travel Agent <alerts@localhost>
# Shown in the app when email is captured, so you can find your messages. Empty = the
# Mailpit web UI on http://localhost:${MAILPIT_UI_PORT} (8025).
DEV_INBOX_URL=
RESEND_API_KEY=
SENDGRID_API_KEY=
# Optional delivery webhooks (provider -> /api/webhooks/resend or /api/webhooks/sendgrid) that
# confirm delivered / bounced. Without them, status stops at "accepted by provider".
RESEND_WEBHOOK_SECRET=
SENDGRID_WEBHOOK_PUBLIC_KEY=
# SMTP server (also used by mailpit). Default localhost; inside Docker, the mailpit service.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
# console | twilio | disabled
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_SENDING_TIMEOUT_MINUTES=10
ALERT_PRICE_DROP_PCT=10
ALERT_PRICE_DROP_MIN_AMOUNT=50
ALERT_SCORE_IMPROVEMENT=10
MAX_ALERTS_PER_USER_PER_DAY=10
# console providers write messages here
OUTBOX_DIR=/tmp/swell-outbox

# ----------------------------------------------------------------------------- ranking & retention
# Optional JSON overriding opportunity ranking weights per priority (see docs/MATCHING_AND_FLIGHTS.md)
RANKING_WEIGHTS_JSON=
# Free-database profile (Neon Free, 1 GB): RETENTION_FORECAST_DAYS=1, RETENTION_JOB_LOG_DAYS=7,
# with RETENTION_ARCHIVE_DAYS=7, SYNC_PRUNE_EACH_PASS=true, DATA_HEALTH_DATABASE_MAX_GB=0.85.
# The values below (full retention) apply again after upgrading the database.
RETENTION_FORECAST_DAYS=10
RETENTION_FLIGHT_DAYS=30
RETENTION_JOB_LOG_DAYS=30
RETENTION_NOTIFICATION_DAYS=365

# ----------------------------------------------------------------------------- data health
# GET /api/health/data and the ops.data_health job (docs/operations.md); hosted profile: 60
DATA_HEALTH_CHECK_MINUTES=15
DATA_HEALTH_ALERTS_ENABLED=true
# degraded above this database size in GB (empty = 20 GB default; an alert only, nothing is
# deleted). Size it from your disk: docs/operations.md, "Capacity". Free-database profile: 0.85.
DATA_HEALTH_DATABASE_MAX_GB=
# degraded once Redis uses more than this fraction of REDIS_MAXMEMORY
DATA_HEALTH_REDIS_MAX_FRACTION=0.8

# ----------------------------------------------------------------------------- frontend
# Read by the Next.js server at build time (export them, or put them in frontend/.env.local
# for `npm run dev`). BACKEND_URL is where /api/* is proxied; compose sets it to the backend service.
BACKEND_URL=http://localhost:8000
# proxy = Next.js rewrites /api/* to BACKEND_URL; platform = the platform routes /api (Vercel
# Services, the local Vercel-style stack). Empty = platform on Vercel (VERCEL=1), else proxy.
API_ROUTING=
# Map tiles. With nothing set the map uses standard OpenStreetMap tiles: no API key, but the
# OSM tile usage policy applies (https://operations.osmfoundation.org/policies/tiles/).
# With Docker, rebuild after changing these: docker compose build frontend && docker compose up -d
# A free CARTO key (https://carto.com/basemaps/apikey/) switches to CARTO Voyager tiles.
# Tile keys are visible in the browser by design; restrict the key to your site's origins.
NEXT_PUBLIC_CARTO_API_KEY=
# Any other Leaflet tile URL template (takes precedence over the CARTO key)
NEXT_PUBLIC_MAP_TILE_URL=
# Attribution HTML required by the tile provider (empty = OpenStreetMap, plus CARTO for CARTO URLs)
NEXT_PUBLIC_MAP_ATTRIBUTION=
# Extra CSP img-src sources, space separated (the tile URL's own host is allowed automatically)
MAP_TILE_HOSTS=
