# The edge of the local Vercel-style stack (docker-compose.vercel.yml): what Vercel's routing
# layer does for the one Services project of vercel.json.
#
# * Services routing (the top-level rewrites): /api/* goes to the "api" service with the
#   original path, everything else to "web". Next.js never sees an /api request.
# * Client IP: Vercel overwrites X-Forwarded-For with the client's address and sets
#   X-Vercel-Forwarded-For and X-Real-IP to the same value; a client cannot set them. The edge
#   does the same with the address of the TCP peer, so a spoofed header never reaches the
#   app (the API reads CLIENT_IP_HEADER=x-vercel-forwarded-for).
# * Function limits of the API: a 4.5 MB request body (Vercel answers 413
#   FUNCTION_PAYLOAD_TOO_LARGE) and maxDuration 60 s (vercel.json; Vercel answers 504).
#
# Not emulated: TLS, Vercel's CDN cache (Cache-Control / CDN-Cache-Control are passed through
# and nothing is cached here), the Firewall and Deployment Protection.
{
	admin off
	auto_https off
	persist_config off
}

(vercel_request_headers) {
	header_up X-Vercel-Forwarded-For {remote_host}
	header_up X-Real-IP {remote_host}
	header_up X-Forwarded-For {remote_host}
	header_up X-Forwarded-Host {host}
	header_up X-Forwarded-Proto {scheme}
}

:8080 {
	# Caddy's proxy adds "Via: 1.x Caddy" to every response; Vercel's routing adds none. A
	# deleting header operation is deferred until the response is written, so it sees it.
	header -Via

	@api path /api/*
	handle @api {
		request_body {
			max_size 4500KB
		}
		reverse_proxy api:8000 {
			import vercel_request_headers
			transport http {
				response_header_timeout 60s
			}
		}
	}

	handle {
		reverse_proxy web:3000 {
			import vercel_request_headers
		}
	}
}
