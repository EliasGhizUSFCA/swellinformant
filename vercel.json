{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend/",
      "framework": "nextjs"
    },
    "api": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "buildCommand": "python -m app.cli migrate --on-build",
      "functions": {
        "app/main.py": {
          "maxDuration": 60,
          "excludeFiles": "{tests/**,**/*.rdb,swell_travel_agent.egg-info/**,build/**}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "daemons": {
    "sync": {
      "root": "./",
      "entrypoint": "Containerfile",
      "instances": { "iad1": 1 },
      "resources": { "requests": { "memory": "2Gi" } },
      "terminationGracePeriodSeconds": 120
    }
  },
  "crons": [{ "path": "/api/internal/cron/daily", "schedule": "23 7 * * *" }]
}
