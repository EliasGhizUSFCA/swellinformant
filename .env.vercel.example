# Swell Travel Agent — environment of the hosted (Vercel) setup and of the local
# Vercel-style stack. Placeholders only: never put a real secret in this file.
#
# Two uses:
# 1. Vercel: the variables of the project (Settings > Environment Variables, Production).
#    Lines marked [Marketplace] are set by the Neon and Upstash integrations: do not type
#    them. docs/deploy-vercel.md has the order of the first deployment.
# 2. The local Vercel-style stack (docs/local-vercel-stack.md):
#      cp .env.vercel.example .env.vercel.local      # git-ignored
#      scripts/vercel-local.sh up
#    Without .env.vercel.local the stack runs the same hosted settings with demo forecasts
#    (synthetic data) and no map layers. With this file copied it uses the live sources
#    below. Whatever this file says, the local stack keeps its own infrastructure values:
#    DATABASE_URL, DATABASE_URL_UNPOOLED and REDIS_URL / KV_URL (VERCEL_LOCAL_* at the end
#    point it elsewhere), APP_ENV=development, COOKIE_SECURE=false, APP_BASE_URL,
#    API_BASE_URL, CORS_ORIGINS, EMAIL_PROVIDER=mailpit and SMTP_*, SMS_PROVIDER=console,
#    CLIENT_IP_HEADER, JOB_RUNNER and ENABLE_DEV_ENDPOINTS=false.
#
# The values are the free hosted setup: profile_env("hosted", "free-database") of
# backend/app/core/profiles.py (backend/tests/unit/test_local_vercel_stack.py checks that
# they match). Empty = the default of backend/app/core/config.py. DB_USE_UNPOOLED=true is
# set by the Containerfile for the sync daemon; do not set it for the project.

# ----------------------------------------------------------------------------- general
APP_ENV=production
LOG_LEVEL=INFO
# A long random value: python3.13 -c "import secrets; print(secrets.token_urlsafe(48))"
# (or: openssl rand -base64 48)
SECRET_KEY=
# HTTPS only (Vercel serves HTTPS).
COOKIE_SECURE=true
# The deployment's public URL, no trailing slash (the *.vercel.app domain until a custom
# domain exists). Email links and the CORS origin use it; web and api share it.
APP_BASE_URL=https://your-project.vercel.app
API_BASE_URL=https://your-project.vercel.app
CORS_ORIGINS=https://your-project.vercel.app
ENABLE_DEV_ENDPOINTS=false

# ----------------------------------------------------------------------------- runner and deployment
# The sync daemon runs the jobs; the API never imports Celery.
JOB_RUNNER=daemon
# Production builds migrate the database (python -m app.cli migrate --on-build).
MIGRATE_ON_BUILD=production
# Vercel sets x-vercel-forwarded-for to the client's address; a client cannot overwrite it.
CLIENT_IP_HEADER=x-vercel-forwarded-for
# Bearer token of the daily watchdog (GET /api/internal/cron/daily, Vercel Cron) and of the
# forecast refresh endpoint its scheduler calls, at least 16 characters:
# python3.13 -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=
# true once the site is used commercially (a paywall, ads): needs OPEN_METEO_API_KEY
# (production refuses to start without it).
COMMERCIAL_USE=false
# The same setting under its Swell 2.0 name; when set it wins over COMMERCIAL_USE.
OPEN_METEO_COMMERCIAL=

# ----------------------------------------------------------------------------- database (Neon)
# [Marketplace] Neon's pooled URL (PgBouncer, host "...-pooler..."): the API.
DATABASE_URL=
# [Marketplace] Neon's direct URL: the sync daemon and the migrations.
DATABASE_URL_UNPOOLED=
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3
DB_POOL_RECYCLE_SECONDS=240
# The pooler runs in transaction mode: never prepare statements.
DB_PREPARED_STATEMENTS=false

# ----------------------------------------------------------------------------- redis (Upstash)
# [Marketplace] Upstash's rediss:// URL. REDIS_URL, when set, wins over it.
KV_URL=
REDIS_CONNECT_TIMEOUT_SECONDS=1.5
REDIS_SOCKET_TIMEOUT_SECONDS=2

# ----------------------------------------------------------------------------- weather data
# Point forecasts for the surf spots, one provider: auto = Windy once WINDY_API_KEY is set and
# WINDY_STORAGE_AUTHORIZED=true, else Open-Meteo (NOAA GFS and GFS-Wave). Or open_meteo,
# windy (refused at start-up until both Windy settings are in place) or demo (synthetic).
WEATHER_PROVIDER=auto
# ADVANCED override of WEATHER_PROVIDER (comma separated, first = primary), e.g. the two
# blended Open-Meteo families of Upgrade 4: open_meteo,open_meteo_ecmwf with
# FORECAST_BLEND_ENABLED=true. Empty = derived from WEATHER_PROVIDER.
FORECAST_PROVIDERS=
FORECAST_BLEND_ENABLED=false
# The rolling forecast horizon in days (3-16).
FORECAST_DAYS=10
# Kill switch of every refresh runner: false = nothing is acquired, the published data stay.
FORECAST_REFRESH_ENABLED=true
# A spot is stale once its data are older than the model's update interval (6 h for GFS)
# plus this many minutes; per model: a JSON object, e.g. {"ncep_gfswave025": 240}.
FORECAST_STALE_THRESHOLD_MINUTES=360
FORECAST_STALE_THRESHOLD_MINUTES_BY_MODEL=
# Empty = the defaults: 0.8 of a spot's hours must carry a wave height and wind; the CDN
# caches GET /api/forecasts/version for 15 s.
FORECAST_MIN_VALID_FRACTION=
FORECAST_VERSION_CDN_SECONDS=
# Optional JSON overriding the quality score's component weights, e.g. {"wind": 0.35}.
SCORING_WEIGHTS_JSON=
# Required with COMMERCIAL_USE=true (the free Open-Meteo API is non-commercial).
OPEN_METEO_API_KEY=
# Windy Point Forecast API (licensed). A key is not a licence: Windy data are stored, scored
# and published only with WINDY_STORAGE_AUTHORIZED=true (formerly WINDY_TERMS_ACKNOWLEDGED),
# set only with a licence that allows this use. Empty check interval and daily limit = 15
# minutes and 10,000 requests.
WINDY_API_KEY=
WINDY_STORAGE_AUTHORIZED=false
WINDY_CHECK_MINUTES=
WINDY_DAILY_REQUEST_LIMIT=
# The worldwide map layers (NOAA GFS), synced with the spot forecasts.
MAP_FIELDS_ENABLED=true
# The map horizon. Empty = the default, 61 map hours a cycle (about 70 MB downloaded per 9
# map hours, docs/sync.md). For a quick local test: MAP_FIELD_STEPS=0-24:3 and
# MAP_FIELD_MAX_LEAD_HOURS=24 (9 map hours).
MAP_FIELD_STEPS=
MAP_FIELD_MAX_LEAD_HOURS=
# The GEFS ensemble is off to protect the daemon's 5 Active CPU-hours a month (Hobby).
GEFS_ENABLED=false
PROVIDER_RESPONSE_CACHE_ENABLED=false
# NOAA CO-OPS asks for an application name on tide requests (empty = the app name).
NOAA_COOPS_APPLICATION=

# ----------------------------------------------------------------------------- sync daemon
# Model-run checks every SYNC_CHECK_MINUTES (empty = 10); docs/sync.md has the others.
SYNC_CHECK_MINUTES=
# Late model domains of one component are waited for this long (empty = 0: no waiting).
SYNC_COALESCE_MINUTES=
# The optional daemon refreshes only the GRIB map layers; the spot refreshes run in a Vercel
# Function called by a scheduler, and without the daemon the refresh endpoint and the daily
# cron run the flight re-checks, matching kicks, email retries and periodic jobs.
SYNC_DAEMON_KINDS=map
# Periodic jobs at most hourly, so a scale-to-zero database is woken at most hourly.
JOB_INTERVAL_FLOOR_MINUTES=60
DATA_HEALTH_CHECK_MINUTES=60
# Health warns at 80 % of this monthly CPU budget (Hobby daemon quota: 5 Active CPU-hours).
SYNC_CPU_BUDGET_HOURS=5
# Admin alerts: an API quota at this fraction (empty = 0.8); no refresh check for this many
# minutes (empty = 30). A hosted deployment needs a scheduler calling /api/internal/refresh
# every 5 minutes (QStash on Hobby, docs/deploy-vercel.md step 7b); keep the alert on so a
# stopped schedule is noticed. 0 silences it: only for a deployment that knowingly refreshes
# once a day from the daily cron alone, which breaks the freshness goal (spec section 9).
QUOTA_ALERT_FRACTION=
REFRESH_SCHEDULER_EXPECTED_MINUTES=

# ----------------------------------------------------------------------------- retention (Neon Free, 1 GB)
# About 1 day of forecast history and 1 week of verification archive and job logs, pruned
# after every sync. After upgrading the database: the "full-retention" profile.
RETENTION_FORECAST_DAYS=1
RETENTION_ARCHIVE_DAYS=7
RETENTION_JOB_LOG_DAYS=7
SYNC_PRUNE_EACH_PASS=true
DATA_HEALTH_DATABASE_MAX_GB=0.85
# A sync for every new spot model run; the optional map layers keep the 06Z and 18Z cycles.
# SYNC_TRIGGER_SOURCES=map is the Upgrade 4 cadence (two syncs a day, about 1.9 GB of egress
# a month measured, docs/map-layers.md "Free database budget"). After upgrading the
# database: SYNC_TRIGGER_SOURCES=spots,map, MAP_FIELD_CYCLES=00,12 and
# PREDICTION_ARCHIVE_ENABLED=true (the "full-retention" profile).
SYNC_TRIGGER_SOURCES=spots
MAP_FIELD_CYCLES=06,18
PREDICTION_ARCHIVE_ENABLED=false

# ----------------------------------------------------------------------------- email and SMS
# Production refuses the capture-only providers (console, mailpit). Resend needs a verified
# sending domain for mail to other people, which a *.vercel.app deployment does not have.
# Before you have a domain: EMAIL_FROM=Swell Travel Agent <onboarding@resend.dev> with a
# free Resend account's key. Resend then delivers only to the address of your Resend
# account ("The resend.dev domain is only available for testing purposes and can only send
# emails to the email address associated with your Resend account"): register on the site
# with that address, verify it, run make-admin and set OPS_ALERT_EMAILS to it. Sign-up stays
# open, but other visitors' verification, password-reset and alert emails reach nobody until
# the domain is verified. Switch EMAIL_FROM to your verified domain once you have one
# (docs/deploy-vercel.md, step 5).
EMAIL_PROVIDER=resend
EMAIL_FROM=Swell Travel Agent <alerts@your-domain.example>
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Optional: addresses (comma-separated) the daily watchdog emails when the database itself
# cannot be reached (e.g. Neon's compute suspended after its monthly quota); the admin
# recipients are read from the database, so they cannot be told then. At most once a day.
OPS_ALERT_EMAILS=
# console = SMS are written to the log only, until Twilio is set up.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ----------------------------------------------------------------------------- flights
# demo = mock itineraries, labelled as such; duffel needs DUFFEL_ACCESS_TOKEN.
FLIGHT_PROVIDER=demo
DUFFEL_ACCESS_TOKEN=
# Empty = the defaults: 20 provider searches a day per user; new searches alert 2-10 days
# ahead; swells 3-7 days ahead rank higher (short notice); detection looks 1-10 days ahead.
FLIGHT_USER_DAILY_QUOTA=
DETECTION_LEAD_MIN_DAYS=
ALERT_LEAD_DEFAULT_MIN_DAYS=
ALERT_LEAD_DEFAULT_MAX_DAYS=
SHORT_NOTICE_MIN_DAYS=
SHORT_NOTICE_MAX_DAYS=

# ----------------------------------------------------------------------------- web (build time)
# The deployment's public URL for the web build (metadataBase); the backend reads it too when
# APP_BASE_URL is empty.
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
# How often an open page asks whether a new forecast version is out (ms, only while visible).
NEXT_PUBLIC_FORECAST_VERSION_POLL_MS=20000
# Map tiles; empty = OpenStreetMap. Read when the web service is built.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
NEXT_PUBLIC_CARTO_API_KEY=
MAP_TILE_HOSTS=

# ----------------------------------------------------------------------------- local stack only
# Read by docker-compose.vercel.yml (scripts/vercel-local.sh), ignored by Vercel. Empty = the
# stack's own Postgres (through PgBouncer for the API), Redis and ports.
# Point the stack at a Neon development branch (pooled and direct URL) or Upstash:
VERCEL_LOCAL_DATABASE_URL=
VERCEL_LOCAL_DATABASE_URL_UNPOOLED=
VERCEL_LOCAL_REDIS_URL=
# Host ports (127.0.0.1): the edge (the app), Postgres, PgBouncer, Redis, Mailpit's inbox.
EDGE_PORT=3100
VERCEL_PG_PORT=55432
VERCEL_PGBOUNCER_PORT=56432
VERCEL_REDIS_PORT=56379
VERCEL_MAILPIT_PORT=18025
